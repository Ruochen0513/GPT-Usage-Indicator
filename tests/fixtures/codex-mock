#!/usr/bin/env python3
"""Test-only executable, speaks account RPC and records its own pid in its cwd."""
import json
import os
from pathlib import Path
import sys
Path('mock.pid').write_text(str(os.getpid()), encoding='utf-8')
for line in sys.stdin:
    msg = json.loads(line)
    method = msg.get('method')
    if 'id' not in msg or method == 'account/rateLimits/read':
        continue
    result = {'account': {'type': 'chatgpt', 'email': 'test@example.invalid'}} if method == 'account/read' else {}
    print(json.dumps({'id': msg['id'], 'result': result}), flush=True)
